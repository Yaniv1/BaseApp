{
    "COMMON": {
        "CONFIG_WRAPPERS": ["{$", "$}"],
        "APP_NAME": "BaseApp",
        "VERSION": "26.06.03.02",
        "DATE_FORMAT": "%Y%m%d",
        "DATETIME_FORMAT": "%Y%m%dT%H%M%SZ",
        "START_TIME": "dt.datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')",
        "RUN_ID": "str(uuid.uuid4().hex[:6]).upper()",
        "HTML_TEMPLATE": "../docs/templates/dataset_table.html",
        "HTML_WRAPPERS": ["{$", "$}"],        
        "OUTPUT_PREFIX": "C:/data/{$APP_NAME$}",
        "OUTPUT_VERSION": "dt.datetime.utcnow().strftime('%Y%m%d')",
        "OUTPUT_PATH": "{$OUTPUT_PREFIX$}/{$OUTPUT_VERSION$}"
    },
    
    "APP": {
        
        "name": "{$APP_NAME$}",
        "version": "{$VERSION$}",       
        "dirs":{
            "data": "{$OUTPUT_PATH$}",
            "config": "config",
            "tests": "test",
            "utils": "utils",
            "templates": "docs/templates"
        },
        "verbose": true
    },

    "LOG":{
        
        "start_time": "{$START_TIME$}",
        "path": "{$OUTPUT_PATH$}/logs",
        "messages_dir": "docs/message_codes",
        "verbose": "INFO",
        "types": {
            "0": "NONE",
            "1": "INFO",
            "2": "GOOD",
            "3": "WARN",
            "4": "ERROR"
        },
        "colors": {
            "INFO": "blue",
            "GOOD": "green",
            "WARN": "yellow",
            "ERROR": "red"
        },
        "max_items": 5
    },

    
    "INPUT": {
        
        "message_codes": {
            "load": true,
            "path": "docs/message_codes",
            "target": "message_codes",
            "format": "csv"
        },
        "updates": {
            "load": true,
            "path": "updates/base.json",
            "target": "updates",
            "format": "json"
        },
        "requirements": {
            "load": true,
            "path": "docs/requirements",
            "target": "requirements",
            "format": "json"
        },
        "tasks": {
            "load": true,
            "path": "docs/tasks",
            "target": "tasks",
            "format": "json"
        }
    },

    "PROCESS": {
        
        "message_codes_df": {
            "run": true,
            "source": "message_codes",
            "context": {
                "message_codes": "message_codes"
            },
            "conversions": [                
                {                    
                    "scope": "df",
                    "op": "pd.concat([frame.assign(source_file=name) for name, frame in message_codes.items()], ignore_index=True)"
                }
            ],
            "target": "message_codes_df"
        }
    },

    
    "OUTPUT": {
        
        "results": {
            "store": true,
            "split": false,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.json",
            "format": "json",
            "max_items": 100
        },
        "results_split": {
            "store": true,
            "split": true,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "format": "json",
            "max_items": 100
        },
        "config": {
            "store": true,
            "source": "CONFIG",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.json",
            "format": "json"
        },
        "results_html": {
            "store": true,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "results_split_html": {
            "store": true,
            "split": 2,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        
        "message_codes_split_html": {
            "store": true,
            "split": 2,
            "source": "RESULTS.message_codes",
            "path": "{$OUTPUT_PATH$}/message_codes",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "requirements_split_html": {
            "store": true,
            "split": 1,
            "source": "RESULTS.requirements",
            "path": "{$OUTPUT_PATH$}/requirements",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "tasks_split_html": {
            "store": true,
            "split": 1,
            "source": "RESULTS.tasks",
            "path": "{$OUTPUT_PATH$}/tasks",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "config_html": {
            "store": true,
            "source": "CONFIG",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },

        "log_html": {
            "store": true,
            "source": "LOGS",
            "path": "{$OUTPUT_PATH$}/html_logs",
            "file": "{$START_TIME$}.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        }
    }

}