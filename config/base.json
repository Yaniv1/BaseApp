{
    "COMMON": {
        "CONFIG_WRAPPERS": [
            "{$",
            "$}"
        ],
        "CONFIG_FILES": {
            "app.json": true
        },
        "APP_NAME": "BaseApp",
        "VERSION": "26.07.02.01",
        "DATE_FORMAT": "%Y%m%d",
        "DATETIME_FORMAT": "%Y%m%dT%H%M%SZ",
        "START_TIME": "dt.datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')",
        "RUN_ID": "str(uuid.uuid4().hex[:6]).upper()",
        "HTML_TEMPLATE": "resources/templates/dataset_table.html",
        "HTML_WRAPPERS": [
            "{$",
            "$}"
        ],
        "OUTPUT_PREFIX": "C:/data/{$APP_NAME$}",
        "OUTPUT_VERSION": "dt.datetime.utcnow().strftime('%Y%m%d')",
        "OUTPUT_PATH": "{$OUTPUT_PREFIX$}/{$OUTPUT_VERSION$}",
        "OUTPUT_WORKERS": "os.cpu_count()"
    },
    "APP": {
        "name": "{$APP_NAME$}",
        "version": "{$VERSION$}",
        "dirs": {
            "data": "{$OUTPUT_PATH$}",
            "config": "config",
            "tests": "test",
            "utils": "utils",
            "templates": "resources/templates"
        },
        "verbose": true,
        "TASK_MANAGER": {
            "prompt_store": "{$OUTPUT_PREFIX$}/task_prompts",
            "result_store": "{$OUTPUT_PREFIX$}/task_results",
            "status_queue": "{$OUTPUT_PREFIX$}/status_queue",
            "request_polling_frequency": 5,
            "ledger_branch": "main",
            "enable": true,
            "templates": {
                "Feature": "task.md",
                "Bug": "task.md",
                "PullBase": "pullbase.md",
                "default": "task.md"
            },
            "views": [
                {
                    "id": "base-priority",
                    "name": "By Priority",
                    "tabs": ["ToDo", "InProgress", "Specified", "Ready"],
                    "sort": {"priority": "desc"},
                    "filter": {}
                },
                {
                    "id": "base-critical",
                    "name": "Critical",
                    "tabs": ["ToDo", "Ready"],
                    "sort": {"priority": "desc"},
                    "filter": {"priority": ["Critical"]}
                },
                {
                    "id": "base-bugs",
                    "name": "Bugs",
                    "tabs": ["ToDo", "InProgress", "Ready", "Deployed"],
                    "sort": {"priority": "desc"},
                    "filter": {"type": ["Bug"]}
                },
                {
                    "id": "base-features",
                    "name": "Features",
                    "tabs": ["ToDo", "InProgress"],
                    "sort": {"priority": "desc"},
                    "filter": {"type": ["Feature"]}
                }
            ]
        }
    },
    "LOG": {
        "start_time": "{$START_TIME$}",
        "path": "{$OUTPUT_PATH$}/Logs/logs",
        "messages_dir": "resources/message_codes",
        "verbose": "INFO",
        "types": {
            "0": "NONE",
            "1": "INFO",
            "2": "GOOD",
            "3": "WARN",
            "4": "ERROR"
        },
        "colors": {
            "INFO": "blue",
            "GOOD": "green",
            "WARN": "yellow",
            "ERROR": "red"
        },
        "max_items": 5
    },
    "INPUT": {
        "message_codes": {
            "load": true,
            "path": "resources/message_codes",
            "target": "message_codes",
            "format": "csv"
        },
        "updates": {
            "load": true,
            "path": "build/updates/base.json",
            "target": "updates",
            "format": "json"
        },
        "requirements": {
            "load": true,
            "path": "build/requirements",
            "target": "requirements",
            "format": "json"
        },
        "tasks": {
            "load": true,
            "path": "build/tasks",
            "target": "tasks",
            "format": "json"
        }
    },
    "PROCESS": {
        "message_codes_df": {
            "run": true,
            "source": "message_codes",
            "context": {
                "message_codes": "message_codes"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "pd.concat([frame.assign(source_file=name) for name, frame in message_codes.items()], ignore_index=True)"
                }
            ],
            "target": "message_codes_df"
        },
        "tasks_df": {
            "run": true,
            "source": "tasks",
            "context": {
                "tasks": "tasks"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "pd.concat([pd.DataFrame(task_dict.get('TASKS', [])).assign(source_file=name) for name, task_dict in tasks.items() if name != 'template.json'], ignore_index=True)"
                }
            ],
            "target": "tasks_df"
        },
        "tasks_filtered": {
            "run": true,
            "source": "tasks",
            "context": {
                "tasks": "tasks"
            },
            "conversions": [
                {
                    "scope": "custom",
                    "op": "{k: v for k, v in tasks.items() if k != 'template.json'}"
                }
            ],
            "target": "tasks_filtered"
        },
        "tasks_by_status": {
            "run": true,
            "source": "tasks_df",
            "context": {
                "tasks": "tasks_df"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "{status: grp.sort_values('priority').to_dict(orient='records') for status, grp in df.groupby('status')}"
                }
            ],
            "target": "tasks_by_status"
        },
        "tasks_by_type_status": {
            "run": true,
            "source": "tasks_df",
            "context": {
                "tasks": "tasks_df"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "{t: {s: grp[(grp['type'].fillna('Feature') == t) & (grp['status'] == s)].sort_values('priority').to_dict(orient='records') for s in grp['status'].unique()} for t, grp in df.assign(type=df['type'].fillna('Feature')).groupby('type')}"
                }
            ],
            "target": "tasks_by_type_status"
        }
    },
    "OUTPUT": {
        "results": {
            "store": true,
            "split": false,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.json",
            "format": "json",
            "max_items": 100
        },
        "results_split": {
            "store": true,
            "split": true,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "format": "json",
            "max_items": 100
        },
        "config": {
            "store": true,
            "source": "CONFIG",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.json",
            "format": "json"
        },
        "results_html": {
            "store": true,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "results_split_html": {
            "store": true,
            "split": 2,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/results",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "message_codes_split_html": {
            "store": true,
            "split": 2,
            "source": "RESULTS.message_codes",
            "path": "{$OUTPUT_PATH$}/message_codes",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "requirements_split_html": {
            "store": true,
            "split": 1,
            "source": "RESULTS.requirements",
            "path": "{$OUTPUT_PATH$}/requirements",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "tasks_split_html": {
            "store": true,
            "split": 1,
            "source": "RESULTS.tasks_filtered",
            "path": "{$OUTPUT_PATH$}/tasks",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "tasks_by_status_split": {
            "store": true,
            "split": 1,
            "source": "RESULTS.tasks_by_status",
            "path": "{$OUTPUT_PATH$}/tasks/reports",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "max_items": 100
        },
        "tasks_by_type_status_split": {
            "store": true,
            "split": 2,
            "source": "RESULTS.tasks_by_type_status",
            "path": "{$OUTPUT_PATH$}/tasks/reports",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "max_items": 100
        },
        "tasks_df_html": {
            "store": true,
            "source": "RESULTS.tasks_df",
            "path": "{$OUTPUT_PATH$}/tasks",
            "file": "tasks.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            }
        },
        "config_html": {
            "store": true,
            "source": "CONFIG",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "log_html": {
            "store": true,
            "source": "LOGS",
            "path": "{$OUTPUT_PATH$}/Logs/HTML",
            "file": "{$START_TIME$}.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "logs_by_type_html": {
            "store": true,
            "split": 1,
            "source": "LOGS",
            "context": {
                "logs": "LOGS"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "{t: grp.sort_values(['elapsed_sec']).to_dict(orient='records') for t, grp in pd.DataFrame(df).groupby('type')}"
                },
                {
                    "scope": "df",
                    "op": "{t: df.get(t, [{k: None for k in pd.DataFrame(logs).columns}]) for t in ['INFO', 'GOOD', 'WARN', 'ERROR']}"
                }
            ],
            "path": "{$OUTPUT_PATH$}/Logs/by_type",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "logs_by_type_json": {
            "store": true,
            "split": 1,
            "source": "LOGS",
            "context": {
                "logs": "LOGS"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "{t: grp.sort_values(['elapsed_sec']).to_dict(orient='records') for t, grp in pd.DataFrame(df).groupby('type')}"
                },
                {
                    "scope": "df",
                    "op": "{t: df.get(t, [{k: None for k in pd.DataFrame(logs).columns}]) for t in ['INFO', 'GOOD', 'WARN', 'ERROR']}"
                }
            ],
            "path": "{$OUTPUT_PATH$}/Logs/by_type",
            "format": "json",            
            "open": false
        },
        "output_map": {
            "store": true,
            "source": "OUTPUT_MAP",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "output_map.json",
            "format": "json"
        },
        "output_map_html": {
            "store": true,
            "source": "OUTPUT_MAP",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "output_map.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        }
    }
}