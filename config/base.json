{
    "COMMON": {
        "CONFIG_WRAPPERS": ["{$", "$}"],
        "APP_NAME": "BaseApp",
        "VERSION": "26.05.26.01",
        "DATE_FORMAT": "%Y%m%d",
        "DATETIME_FORMAT": "%Y%m%dT%H%M%SZ",
        "START_TIME": "dt.datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')",
        "RUN_ID": "str(uuid.uuid4().hex[:6]).upper()",
        "HTML_TEMPLATE": "../docs/templates/dataset_table.html",
        "HTML_WRAPPERS": ["{$", "$}"],        
        "OUTPUT_PREFIX": "C:/data/{$APP_NAME$}",
        "OUTPUT_VERSION": "dt.datetime.utcnow().strftime('%Y%m%d')",
        "OUTPUT_PATH": "{$OUTPUT_PREFIX$}/{$OUTPUT_VERSION$}"
    },
    
    "app": {
        "name": "{$APP_NAME$}",
        "version": "{$VERSION$}",       
        "dirs":{
            "data": "{$OUTPUT_PATH$}",
            "config": "config",
            "utils": "utils",
            "templates": "docs/templates"
        },
        "verbose": true
    },

    "log":{
        "start_time": "{$START_TIME$}",
        "path": "{$OUTPUT_PATH$}/logs",
        "messages_dir": "docs/message_codes",
        "verbose": "INFO",
        "types": {
            "0": "NONE",
            "1": "INFO",
            "2": "GOOD",
            "3": "WARN",
            "4": "ERROR"
        },
        "colors": {
            "INFO": "blue",
            "GOOD": "green",
            "WARN": "yellow",
            "ERROR": "red"
        },
        "max_items": 5
    },

    
    "input": {
        "message_codes": {
            "load": true,
            "path": "docs/message_codes",
            "target": "message_codes",
            "format": "csv"
        },
        "updates": {
            "load": true,
            "path": "updates/base.json",
            "target": "updates",
            "format": "json"
        }
    },

    
    "output": {
        "results": {
            "store": true,
            "source": "results",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.json",
            "format": "json",
            "max_items": 100
        },
        "config": {
            "store": true,
            "source": "config",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.json",
            "format": "json"
        },
        "results_html": {
            "store": true,
            "source": "results",
            "path": "{$OUTPUT_PATH$}/results",
            "file": "results.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "config_html": {
            "store": true,
            "source": "config",
            "path": "{$OUTPUT_PATH$}/config",
            "file": "config.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },

        "log_html": {
            "store": true,
            "source": "logs",
            "path": "{$OUTPUT_PATH$}/html_logs",
            "file": "{$START_TIME$}.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        }
    }

}