{    
    "COMMON": {
        "OUTPUT_PATH": "{$OUTPUT_PREFIX$}/{$OUTPUT_VERSION$}/TESTS_RESULTS"
        
    },
    "TESTING": {
        "settings": {
            "enabled": true,
            "fail_fast": false,
            "fail_on": ["FAIL"],
            "monitor": {
                "buffer_path": null
            }
        },
        "test_logger": {
            "path": "{$OUTPUT_PATH$}/test_results",
            "messages_dir": "resources/message_codes",
            "verbose": "PASS",
            "types": {
                "0": "NONE",
                "1": "INFO",
                "2": "PASS",
                "3": "WARN",
                "4": "FAIL",
                "5": "GOOD"
            },
            "colors": {
                "PASS": "green",
                "GOOD": "lightgreen",
                "WARN": "yellow",
                "FAIL": "red"
            },
            "max_items": 10
        },
        "build": [
            {
                "id": "test_deployment",
                "name": "Test App Deployment",
                "callable": "utils.testutils.test_deployment",
                "inputs": {
                    "message": "Run the app test deployment script and assert expected outcomes at each phase",
                    "script_path": "scripts/test_deployment.ps1"
                }
            }
        ],
        "prep": [
            {
                "id": "prep_architecture_alignment",
                "name": "Prep architecture alignment",
                "callable": "test.tests.base.base.ArchitectureAlignmentTest",
                "inputs": {
                    "message": "Validated the codebase against docs/architecture and generated candidate temp architecture files",
                    "artifact_rel_dir": "tests/architecture",
                    "architecture_html_file": "combined_architecture.html",
                    "code_tree_html_file": "code_tree.html"
                }
            },
            {
                "id": "prep_config_ready",
                "name": "Prep config readiness",
                "callable": "utils.testutils.evaluate_checks",
                "inputs": {
                    "message": "Validated required runtime configuration",
                    "checks": [
                        {
                            "name": "app_name_present",
                            "operator": "truthy",
                            "actual": {"ref": "config.COMMON.APP_NAME"}
                        },
                        {
                            "name": "output_path_present",
                            "operator": "truthy",
                            "actual": {"ref": "config.COMMON.OUTPUT_PATH"}
                        },
                        {
                            "name": "test_logger_path_present",
                            "operator": "truthy",
                            "actual": {"ref": "config.TESTING.test_logger.path"}
                        }
                    ]
                }
            },
            {
                "id": "prep_input_delta_mode",
                "name": "Prep input delta mode",
                "callable": "test.tests.base.input.test_input_delta",
                "inputs": {
                    "message": "Validated DataLoader delta mode across new, unchanged, modified, and added files"
                }
            },
            {
                "id": "prep_output_delta_mode",
                "name": "Prep output delta mode",
                "callable": "test.tests.base.output.test_output_delta",
                "inputs": {
                    "message": "Validated _save_output_artifact delta mode for skip, overwrite, and missing-file paths"
                }
            },
            {
                "id": "prep_concurrent_store_outputs",
                "name": "Prep concurrent store outputs",
                "callable": "test.tests.base.output.test_concurrent_store_outputs",
                "inputs": {
                    "message": "Validated store_outputs concurrent mode: all artifacts written, errors isolated, lock present"
                }
            },
            {
                "id": "prep_to_json_compatible",
                "name": "Prep to_json_compatible",
                "callable": "test.tests.base.output.test_to_json_compatible",
                "inputs": {
                    "message": "Validated to_json_compatible module-level function: import, type conversions, and JSON serialization"
                }
            },
            {
                "id": "prep_output_file_mapping",
                "name": "Prep output file mapping",
                "callable": "test.tests.base.output.test_output_file_mapping",
                "inputs": {
                    "message": "Validated OUTPUT_MAP: init, keys, path existence, accumulation across calls, concurrent mode parity, return value, and OUTPUT_MAP-sourced output written with full map"
                }
            },
            {
                "id": "prep_html_hyperlinks",
                "name": "Prep html hyperlinks",
                "callable": "test.tests.base.output.test_html_hyperlinks",
                "inputs": {
                    "message": "Validated HtmlDoc renders file paths and URLs as clickable anchor tags"
                }
            },
            {
                "id": "prep_pullbase_once_sync",
                "name": "Prep pullbase once sync",
                "callable": "test.tests.base.pullbase.test_pullbase_once_sync",
                "inputs": {
                    "message": "Validated pullbase once-pull sync: load_once_entries reads manifest entries and pull_once_files copies missing files while skipping existing ones"
                }
            },
            {
                "id": "prep_dataconverter_error_handling",
                "name": "Prep DataConverter error handling",
                "callable": "test.tests.base.output.test_dataconverter_error_handling",
                "inputs": {
                    "message": "Validated DataConverter per-step exception handling: errors list, DATAE01 logging, step isolation, and list reset"
                }
            },
            {
                "id": "prep_dataconverter_json_column",
                "name": "Prep DataConverter JSON column parsing",
                "callable": "test.tests.base.output.test_dataconverter_json_column",
                "inputs": {
                    "message": "Validated DataConverter json.loads column conversion on ExtendedProps/Schema demo dataset mirroring rdd_summary CSV structure"
                }
            },
            {
                "id": "prep_instantiate_config_overrides",
                "name": "Prep instantiate config overrides",
                "callable": "test.tests.base.instantiate.test_instantiate_config_overrides",
                "inputs": {
                    "message": "Validated instantiate config overrides: load_overrides parses JSON file and string, populate_app_config deep-merges overrides, _deep_merge preserves sibling keys"
                }
            },
            {
                "id": "prep_instantiate_branch_aware_layout",
                "name": "Prep instantiate branch-aware layout",
                "callable": "test.tests.base.instantiate.test_instantiate_branch_aware_layout",
                "inputs": {
                    "message": "Validated branch-aware deployment layout: resolve_app_root derives {container}/{app-name}/{branch} and populate_local_config records COMMON.BASEAPP while preserving existing keys"
                }
            },
            {
                "id": "prep_instantiate_layout_survives_git_init",
                "name": "Prep instantiate layout survives git init",
                "callable": "test.tests.base.instantiate.test_instantiate_layout_survives_git_init",
                "inputs": {
                    "message": "Validated instantiate writes no git metadata and its layout survives a post-hoc git init with template files preserved and tracked"
                }
            },
            {
                "id": "prep_pullbase_baseapp_resolution",
                "name": "Prep pullbase BaseApp resolution",
                "callable": "test.tests.base.pullbase.test_pullbase_baseapp_resolution_with_main_fallback",
                "inputs": {
                    "message": "Validated resolve_baseapp_source: task worktree falls back to main local.json, --branch swaps the BASEAPP leaf, and explicit --baseSource is used when no BASEAPP is recorded"
                }
            },
            {
                "id": "prep_pullbase_refuses_self_pull",
                "name": "Prep pullbase self-pull guard",
                "callable": "test.tests.base.pullbase.test_pullbase_refuses_self_pull",
                "inputs": {
                    "message": "Validated is_self_pull: pullbase refuses when source and local app are the same repository (sibling worktrees, shared container, or same folder) and allows a distinct variant container"
                }
            },
            {
                "id": "prep_local_config_override",
                "name": "Prep local config override",
                "callable": "test.tests.base.config.test_local_config_override",
                "inputs": {
                    "message": "Validated config/local.json local override: file exists, overrides app values, preserves non-overridden keys, and config loads fine when local.json is absent"
                }
            },
            {
                "id": "prep_task_manager_interface",
                "name": "Prep task manager interface",
                "callable": "test.tests.base.task_manager.test_task_manager_interface",
                "inputs": {
                    "message": "Validated the local task manager UI: load, create, update, comment, and HTTP persistence against build/tasks/base.json"
                }
            },
            {
                "id": "prep_task_manager_interface",
                "name": "Prep task manager interface",
                "callable": "test.tests.base.task_manager.test_task_manager_interface",
                "inputs": {
                    "message": "Validated the local task manager UI: load, create, update, comment, and HTTP persistence against build/tasks/base.json"
                }
            }
        ],
        "live": [
            {
                "id": "live_monitor_activity",
                "name": "Live monitor activity",
                "callable": "utils.testutils.monitor_activity",
                "frequency_seconds": 1,
                "max_runs": 1,
                "inputs": {
                    "message": "Observed monitor publications while the app was running",
                    "min_history": 1
                }
            },
            {
                "id": "live_mcp_server_status",
                "name": "Live MCP servers health",
                "callable": "utils.testutils.mcp_server_status",
                "frequency_seconds": 60,
                "inputs": {
                    "message": null,
                    "timeout": 10
                }
            }
        ],
        "post": [
            {
                "id": "post_runtime_artifacts",
                "name": "Post runtime artifacts",
                "callable": "utils.testutils.evaluate_checks",
                "inputs": {
                    "message": "Validated runtime outputs and lifecycle values",
                    "checks": [
                        {
                            "name": "end_time_present",
                            "operator": "exists",
                            "actual": {"ref": "monitor.results.end_time"}
                        },
                        {
                            "name": "elapsed_seconds_non_negative",
                            "operator": "ge",
                            "actual": {"ref": "monitor.results.elapsed_seconds"},
                            "expected": 0
                        },
                        {
                            "name": "message_codes_loaded",
                            "operator": "exists",
                            "actual": {"ref": "monitor.results.message_codes_loaded"}
                        },
                        {
                            "name": "requirements_loaded",
                            "operator": "exists",
                            "actual": {"ref": "monitor.results.requirements_loaded"}
                        },
                        {
                            "name": "tasks_loaded",
                            "operator": "exists",
                            "actual": {"ref": "monitor.results.tasks_loaded"}
                        }
                    ]
                }
            },
            {
                "id": "post_tasks_by_status",
                "name": "Post tasks by status",
                "callable": "test.tests.base.base.test_tasks_by_status",
                "inputs": {
                    "message": "Validated tasks grouped by status in process output"
                }
            },
            {
                "id": "post_tasks_by_type_status",
                "name": "Post tasks by type and status",
                "callable": "test.tests.base.base.test_tasks_by_type_status",
                "inputs": {
                    "message": "Validated tasks grouped by type and status in process output"
                }
            },
            {
                "id": "post_logs_by_type",
                "name": "Post logs by type",
                "callable": "test.tests.base.output.test_logs_by_type",
                "inputs": {
                    "message": "Validated logs_by_type output files exist after app run"
                }
            }
        ]
    },

    "OUTPUT": {

        "config": {
            "path": "{$OUTPUT_PATH$}/tests/config",
            "file": "test_config.json"
        },
        "config_html": {
            "path": "{$OUTPUT_PATH$}/tests/config",
            "file": "test_config.html"
        },
        "results": {
            "store": true,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/tests/results",
            "file": "{$START_TIME$}.json",
            "format": "json"
        },
        "results_html": {
            "store": true,
            "split": false,
            "source": "RESULTS",
            "path": "{$OUTPUT_PATH$}/tests/results",
            "file": "test_results.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "summary_html": {
            "store": true,
            "split": false,
            "source": "RESULTS.summary",
            "path": "{$OUTPUT_PATH$}/tests/summary",
            "file": "summary.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "test_log_html": {
            "store": true,
            "source": "test_logger.logs",
            "path": "{$OUTPUT_PATH$}/tests/logs",
            "file": "test_log.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "test_log_by_type_html": {
            "store": true,
            "split": 1,
            "source": "test_logger.logs",
            "context": {
                "logs": "test_logger.logs"
            },
            "conversions": [
                {
                    "scope": "df",
                    "op": "{t: grp.sort_values(['elapsed_sec']).to_dict(orient='records') for t, grp in pd.DataFrame(df).groupby('type')}"
                },
                {
                    "scope": "df",
                    "op": "{t: df.get(t, [{k: None for k in pd.DataFrame(logs).columns}]) for t in ['INFO', 'PASS', 'GOOD', 'WARN', 'FAIL']}"
                }
            ],
            "path": "{$OUTPUT_PATH$}/tests/logs/by_type",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        },
        "test_config_html": {
            "store": true,
            "source": "CONFIG",
            "path": "{$OUTPUT_PATH$}/tests/config",
            "file": "test_config.html",
            "format": "html",
            "kwargs": {
                "template": "{$HTML_TEMPLATE$}"
            },
            "open": false
        }
    }
}